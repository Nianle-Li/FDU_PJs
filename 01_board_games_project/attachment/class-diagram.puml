@startuml BoardGameClassDiagram
' filepath: d:\project\vscode\java_lab\pj\docs\class-diagram.puml

!theme plain
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "思源黑体 CN", "Source Han Sans CN", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif
skinparam defaultFontSize 11
skinparam packageFontSize 16  // 将包标题字体放大
skinparam classFontSize 10
skinparam titleFontSize 18    // 稍微增大主标题字体以匹配
skinparam packageStyle rectangle
skinparam roundCorner 5
skinparam linetype ortho

' 彩色包样式配置 - 加粗边框 (保持不变)
skinparam package {
    BackgroundColor<<Domain>> #E8F5E8
    BorderColor<<Domain>> #2E7D32
    BorderThickness<<Domain>> 3
    FontColor<<Domain>> #1B5E20
    FontStyle<<Domain>> bold
    
    BackgroundColor<<Game>> #E3F2FD
    BorderColor<<Game>> #1565C0
    BorderThickness<<Game>> 3
    FontColor<<Game>> #0D47A1
    FontStyle<<Game>> bold
    
    BackgroundColor<<GUI>> #FFF3E0
    BorderColor<<GUI>> #E65100
    BorderThickness<<GUI>> 3
    FontColor<<GUI>> #BF360C
    FontStyle<<GUI>> bold
    
    BackgroundColor<<Console>> #F3E5F5
    BorderColor<<Console>> #6A1B9A
    BorderThickness<<Console>> 3
    FontColor<<Console>> #4A148C
    FontStyle<<Console>> bold
    
    BackgroundColor<<SubPackage>> #F8F9FA
    BorderColor<<SubPackage>> #495057
    BorderThickness<<SubPackage>> 2
    FontColor<<SubPackage>> #212529
    FontStyle<<SubPackage>> bold
}

' 彩色类样式配置 (保持不变)
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #6C757D
    ArrowColor #495057
    AttributeFontColor #000000
    FontColor #000000
    FontStyle bold
}

skinparam enum {
    BackgroundColor #FFE4CC
    BorderColor #FF8C00
    FontColor #000000
    FontStyle bold
}

skinparam interface {
    BackgroundColor #E6E6FA
    BorderColor #6A5ACD
    FontColor #000000
    FontStyle bold
}

skinparam abstract {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
    FontColor #000000
    FontStyle bold
}

skinparam note {
    BackgroundColor #FFFACD
    BorderColor #DAA520
    FontColor #B8860B
    FontStyle bold
}

title <color:#2F2F2F><size:20><b>棋类游戏系统 - UML静态类图</b></size></color> // 稍微增大主标题字体

' === 领域模型层 ===
package "🎯 domain.board" <<Domain>> {
    
    enum PieceColor {
        <color:#D2691E><b>BLACK</b></color>
        <color:#D2691E><b>WHITE</b></color>
        <color:#D2691E><b>BARRIER</b></color>
        <color:#D2691E><b>BOMB_CRATER</b></color>
        --
        <color:#2E7D32><b>+ oppositeColor(): PieceColor</b></color>
        <color:#2E7D32><b>+ allColors(): PieceColor[]</b></color>
        <color:#2E7D32><b>+ toString(): String</b></color>
    }
    
    enum Direction {
        <color:#D2691E><b>UP, DOWN, LEFT, RIGHT</b></color>
        <color:#D2691E><b>UP_LEFT, UP_RIGHT</b></color>
        <color:#D2691E><b>DOWN_LEFT, DOWN_RIGHT</b></color>
        --
        <color:#8B0000><b>- dx: int</b></color>
        <color:#8B0000><b>- dy: int</b></color>
        --
        <color:#2E7D32><b>+ getDx(): int</b></color>
