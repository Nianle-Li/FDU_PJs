        <color:#2E7D32><b>+ getAllDirections(): Direction[]</b></color>
        <color:#2E7D32><b>+ getOppositeDirections(): Direction[][]</b></color>
    }
    
    class Board {
        <color:#8B0000><b>- size: int</b></color>
        <color:#8B0000><b>- grid: PieceColor[][]</b></color>
        --
        <color:#2E7D32><b>+ Board(int)</b></color>
        <color:#2E7D32><b>+ Board(PieceColor[][])</b></color>
        <color:#2E7D32><b>+ placePiece(Location, PieceColor): void</b></color>
        <color:#2E7D32><b>+ replacePiece(Location, PieceColor): void</b></color>
        <color:#2E7D32><b>+ getPiece(Location): PieceColor</b></color>
        <color:#2E7D32><b>+ getPiece(int, int): PieceColor</b></color>
        <color:#2E7D32><b>+ isValidLocation(Location): boolean</b></color>
        <color:#2E7D32><b>+ isValidPlacement(Location): boolean</b></color>
        <color:#2E7D32><b>+ getLine(Location, Direction): List<Piece></b></color>
        <color:#2E7D32><b>+ getAll(boolean): Piece[]</b></color>
        <color:#2E7D32><b>+ getPieceCount(PieceColor): int</b></color>
        <color:#2E7D32><b>+ clear(): void</b></color>
        <color:#2E7D32><b>+ getSize(): int</b></color>
    }
    
    class Location {
        <color:#8B0000><b>- x: int</b></color>
        <color:#8B0000><b>- y: int</b></color>
        --
        <color:#2E7D32><b>+ of(int, int): Location {static}</b></color>
        <color:#2E7D32><b>+ at(Direction): Location</b></color>
        <color:#2E7D32><b>+ getX(): int</b></color>
        <color:#2E7D32><b>+ getY(): int</b></color>
        <color:#2E7D32><b>+ equals(Object): boolean</b></color>
        <color:#2E7D32><b>+ hashCode(): int</b></color>
        <color:#2E7D32><b>+ toString(): String</b></color>
    }
    
    class Piece {
        <color:#8B0000><b>- location: Location</b></color>
        <color:#8B0000><b>- color: PieceColor</b></color>
        --
        <color:#2E7D32><b>+ Piece(Location, PieceColor)</b></color>
        <color:#2E7D32><b>+ Piece(int, int, PieceColor)</b></color>
        <color:#2E7D32><b>+ getLocation(): Location</b></color>
        <color:#2E7D32><b>+ getColor(): PieceColor</b></color>
        <color:#2E7D32><b>+ isOccupied(): boolean</b></color>
    }
    
    class BoardException {
        <color:#2E7D32><b>+ BoardException(String)</b></color>
    }
}

