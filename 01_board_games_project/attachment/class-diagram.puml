        <color:#1565C0><b>+ placePiece(Location): boolean</b></color>
        <color:#1565C0><b>+ useBomb(Location): boolean</b></color>
        <color:#1565C0><b>+ executeAction(String, Object...): boolean</b></color>
        <color:#1565C0><b>+ getPlayerBombs(PieceColor): Integer</b></color>
        <color:#1565C0><b>+ getCurrentRound(): Integer</b></color>
